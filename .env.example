# --- Ollama ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_LLM_MODEL=qwen2.5:7b-instruct-q4_K_M
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_KEEP_ALIVE=5m

# --- Qdrant ---
QDRANT_HOST=http://localhost:6333
QDRANT_COLLECTION=obsidian-vault
EMBEDDING_SIZE=768

# --- RAG ---
RAG_TOP_K=4
# Rutas asumiendo que el proceso corre con CWD=apps/orchestrator (ver README). En Docker,
# docker-compose las sobreescribe con las rutas absolutas dentro del contenedor.
VAULT_PATH=../../vault
SYSTEM_PROMPT_PATH=../../prompts/system/assistant.md
TOOLS_SCHEMA_DIR=../../prompts/tools

# --- Orchestrator (FastAPI) ---
ORCHESTRATOR_HOST=0.0.0.0
ORCHESTRATOR_PORT=8000
LOG_LEVEL=info

# --- STT ---
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=es

# --- VAD (webrtcvad) ---
VAD_AGGRESSIVENESS=2
VAD_WINDOW_MS=300

# --- TTS (Piper como subproceso CLI, ver docs/adr/0007) ---
PIPER_BINARY=piper
# Ruta asumiendo CWD=apps/orchestrator, igual que VAULT_PATH/SYSTEM_PROMPT_PATH.
PIPER_MODELS_DIR=../../models/piper
PIPER_VOICE=es_ES-davefx-medium
